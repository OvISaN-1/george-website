// Cloudflare Workers settings. The site's files are served as they are
// (no build step). Only /api/... runs code: worker/index.js, which fetches
// live Forest data (its API key is a secret set in the Cloudflare dashboard)
// and the SATs "Ask the Coach" helper (worker/coach.js), which uses
// Cloudflare's built-in AI through the "AI" binding below.
{
  "name": "george-website",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // A friendly page (404.html) for addresses that do not exist.
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  // Keep variables added in the Cloudflare dashboard when a new version is
  // published (otherwise a plain-text variable would be wiped on each deploy).
  "keep_vars": true
}
